{
  "metadata": {
    "policy_type": "ods_scheduled_scan_policies",
    "version": "1.0.0",
    "description": "Grading standards for CrowdStrike Falcon On-Demand Scan scheduled scan policies",
    "authors": [{"name": "Scott MacGregor", "company": "CrowdStrike"}],
    "last_modified": "2026-03-23",
    "references": []
  },
  "platform_requirements": [
    {
      "platform_name": "Windows",
      "policy_requirements": {
        "status": "scheduled",
        "schedule": {
          "interval": {
            "maximum": 7
          }
        },
        "cloud_ml_level_detection": {
          "minimum": 2
        },
        "sensor_ml_level_detection": {
          "minimum": 2
        },
        "cloud_ml_level_prevention": {
          "minimum": 2
        },
        "sensor_ml_level_prevention": {
          "minimum": 2
        },
        "cloud_pup_adware_level_prevention": {
          "minimum": 2
        },
        "quarantine": true
      }
    }
  ]
}
